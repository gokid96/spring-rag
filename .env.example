# cp .env.example .env  (git 제외)
# 프로필(--spring.profiles.active=openai|bifrost|ollama) 또는 아래 값 직접 입력

# 공통 (채팅 · 임베딩 같은 서버)
LLM_BASE_URL=
LLM_API_KEY=

# 분리 (비우면 공통 값)
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 임베딩 모델 차원 (text-embedding-3-small=1536, bge-m3=1024)
EMBEDDING_DIMENSIONS=

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/rag
SPRING_DATASOURCE_USERNAME=rag
SPRING_DATASOURCE_PASSWORD=rag-local-only

# 문서 · 프롬프트 (회사마다 바뀌는 것)
RAG_DOCS_PATH=./docs
RAG_INDEX_ON_STARTUP=true
RAG_SYSTEM_PROMPT=classpath:prompts/system.st
RAG_ADMIN_TOKEN=

# 검색
RAG_KEYWORD_SEARCH=true
RAG_CHAT_REWRITE=true
# 리랭커 (선택, 비우면 끔). api: tei | cohere
RERANK_URL=
RERANK_API=tei
RERANK_MODEL=
RERANK_API_KEY=

# 예약 색인 (바뀐 문서만). "-" 면 끔
RAG_INDEX_CRON=0 0 3 * * *

# 선택 출처: BookStack (shelf id 쉼표 구분)
BOOKSTACK_ENABLED=false
BOOKSTACK_BASE_URL=
BOOKSTACK_TOKEN=
BOOKSTACK_SHELVES=

# 선택 출처: Confluence
# Cloud: BASE_URL=https://<회사>.atlassian.net/wiki, EMAIL + API 토큰
# Data Center: DEPLOYMENT=datacenter, BASE_URL=https://wiki.<회사>.com, 개인 액세스 토큰 (EMAIL 비움)
CONFLUENCE_ENABLED=false
CONFLUENCE_DEPLOYMENT=cloud
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_TOKEN=
CONFLUENCE_SPACES=
